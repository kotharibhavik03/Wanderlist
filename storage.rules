rules_version = '2';

// Wanderlist Storage rules: photo files. Place photos are downloaded over HTTPS as the
// signed-in user, so these rules check every download against the place and the photo's
// document in Firestore (who's on the place, and whether the photo is private).
// Deploy after every change (see README).

service firebase.storage {
  match /b/{bucket}/o {

    // profiles/{uid}/{photoId}.jpg: profile photos people upload. Everyone else loads them from
    // the download URL in the owner's Firestore profile.
    match /profiles/{uid}/{fileName} {

      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isOwner();

      // New files only, compressed JPEGs under 5 MB (same as place photos).
      allow create: if isOwner()
        && resource == null
        && fileName.matches('[A-Za-z0-9_-]+[.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;

      allow delete: if isOwner();
    }

    // places/{placeId}/{uploaderId}/{photoId}.jpg and {photoId}_thumb.jpg (its thumbnail):
    // everyone writes only in their own folder.
    match /places/{placeId}/{uploaderId}/{fileName} {

      function isUploader() {
        return request.auth != null && request.auth.uid == uploaderId;
      }

      // The place's owner, looked up in Firestore. Deleting a place (or removing a member)
      // deletes other people's photos too, and the place is deleted only after its files.
      function ownsPlace() {
        return request.auth != null
          && firestore.get(/databases/(default)/documents/places/$(placeId)).data.ownerId
               == request.auth.uid;
      }

      // The same people firestore.rules lets read the photo's document: everyone on the place
      // (owner or member) for a shared photo. The document must name this folder's uploader, so
      // a file can't be reached through someone else's photo document. A member who leaves, or a
      // photo made private, is locked out on the next download.
      function canSeePhoto() {
        let photoId = fileName.split('_thumb|[.]')[0];
        let place = firestore.get(/databases/(default)/documents/places/$(placeId)).data;
        let photo = firestore.get(/databases/(default)/documents/places/$(placeId)/photos/$(photoId)).data;
        return request.auth != null
          && (place.ownerId == request.auth.uid
              || request.auth.token.email.lower() in place.memberEmails)
          && photo.uploaderId == uploaderId
          && photo.isPrivate == false;
      }

      // One file at a time (no listing folders). Uploaders always see their own files, private
      // ones included; that's checked first, so it costs no Firestore lookups.
      allow get: if isUploader() || canSeePhoto();

      // New files only (an existing file can't be overwritten), compressed JPEGs under 5 MB.
      allow create: if isUploader()
        && resource == null
        && fileName.matches('[A-Za-z0-9_-]+[.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;

      // Uploaders delete their own files (and so when leaving a place); owners any file on their place.
      allow delete: if isUploader() || ownsPlace();
    }
  }
}
