rules_version = '2';

// Wanderlist security rules. These are the real access control: the app hides what a user
// can't do, but only these rules stop it. Deploy after every change (see README).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Reserved for a per-user profile document.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // profiles/{email}: a user's public name and photo, keyed by their lowercase email so
    // people on a shared place can see each other's names.
    match /profiles/{email} {
      // Read one profile whose email you already know. No list: nobody can enumerate users.
      allow get: if signedIn();

      // Only the owner of that email publishes it, and only these fields. customPhotoId names
      // the photo they uploaded (storage.rules: profiles/{uid}/{customPhotoId}.jpg).
      allow create, update: if signedIn()
        && request.auth.token.email.lower() == email
        && request.resource.data.keys().hasOnly(['uid', 'name', 'photoUrl', 'customPhotoId', 'updatedAt'])
        && (request.resource.data.get('customPhotoId', null) == null
            || (request.resource.data.customPhotoId is string
                && request.resource.data.customPhotoId.matches('[A-Za-z0-9_-]{1,64}')))
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.get('name', null) == null
            || (request.resource.data.name is string && request.resource.data.name.size() <= 200))
        && (request.resource.data.get('photoUrl', null) == null
            || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2000))
        && request.resource.data.updatedAt is int;

      allow delete: if signedIn() && request.auth.token.email.lower() == email;
    }

    // collections/{collectionId}: private to its owner. People a place is shared with
    // never see the collection it belongs to.
    match /collections/{collectionId} {

      // Field names and limits mirror CollectionDocument and CreateCollectionUseCase.
      function isValidCollection(data) {
        return data.keys().hasOnly(['ownerId', 'name', 'icon', 'colors', 'createdAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 40
          && data.icon is string && data.icon.size() > 0 && data.icon.size() <= 16
          && data.colors is list && data.colors.size() > 0 && data.colors.size() <= 10
          && data.createdAt is int;
      }

      // Also governs queries: a list query must filter on ownerId == the caller's uid.
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isValidCollection(request.resource.data);

      // Ownership can't be handed to someone else.
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && isValidCollection(request.resource.data);

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // places/{placeId}: readable by its owner and by people it is shared with (by email).
    //   owner        - everything, including moving it to another of their collections
    //   collaborator - the place itself, but not its collection or its people
    //   any member   - leave, removing only themselves
    //   anyone on it - add their own photos, delete their own (the owner deletes any)
    //   delete       - owner only
    match /places/{placeId} {

      function myEmail() {
        return request.auth.token.email.lower();
      }

      function ownsCollection(collectionId) {
        return get(/databases/$(database)/documents/collections/$(collectionId)).data.ownerId
          == request.auth.uid;
      }

      // The photo index: photo id -> uploader id (PlaceDocument.photoUploaders). Places saved
      // before it existed have none.
      function photoIndex(data) {
        return data.get('photoUploaders', {});
      }

      // The index keeps only entries it already had, unchanged: entries can be removed, not added.
      function photoIndexOnlyShrinks() {
        let diff = photoIndex(request.resource.data).diff(photoIndex(resource.data));
        return diff.addedKeys().size() == 0 && diff.changedKeys().size() == 0;
      }

      // How many of the index's photos are the caller's.
      function myPhotoCount(index) {
        return index.size() - index.values().removeAll([request.auth.uid]).size();
      }

      // Only entries were added, and as many as the caller's count grew by: all of them are theirs.
      function addsOnlyMyPhotos() {
        let before = photoIndex(resource.data);
        let after = photoIndex(request.resource.data);
        let diff = after.diff(before);
        return diff.removedKeys().size() == 0 && diff.changedKeys().size() == 0
          && diff.addedKeys().size() == myPhotoCount(after) - myPhotoCount(before);
      }

      // Only entries were removed, and as many as the caller's count shrank by: all were theirs.
      function removesOnlyMyPhotos() {
        let before = photoIndex(resource.data);
        let after = photoIndex(request.resource.data);
        return photoIndexOnlyShrinks()
          && after.diff(before).removedKeys().size() == myPhotoCount(before) - myPhotoCount(after);
      }

      // Leaving: all of the caller's photos left the index, nobody else's.
      function removesExactlyMyPhotos() {
        return removesOnlyMyPhotos() && myPhotoCount(photoIndex(request.resource.data)) == 0;
      }

      // The marker is unchanged, or it showed a photo this write removes from the index and is
      // now the collection's. (With removesOnlyMyPhotos, that photo was the caller's.)
      function keepsMarkerOrDropsRemovedPhoto() {
        return request.resource.data.marker == resource.data.marker
          || (resource.data.marker.type == 'PHOTO'
              && resource.data.marker.photoId in photoIndex(resource.data)
              && !(resource.data.marker.photoId in photoIndex(request.resource.data))
              && request.resource.data.marker.type == 'COLLECTION');
      }

      // Field names and limits mirror PlaceDocument and validatePlaceDetails.
      function isValidPlace(data) {
        return data.keys().hasOnly([
            'ownerId', 'ownerName', 'ownerEmail', 'collectionId', 'actualName', 'customName', 'address',
            'latitude', 'longitude', 'status', 'visitedOn', 'rating', 'notes', 'marker',
            'members', 'memberEmails', 'collaboratorEmails', 'photoUploaders', 'createdAt', 'updatedAt'
          ])
          && data.ownerId is string
          && (data.get('ownerName', null) == null
              || (data.ownerName is string && data.ownerName.size() <= 200))
          && (data.get('ownerEmail', null) == null || data.ownerEmail is string)
          && data.collectionId is string
          && data.actualName is string && data.actualName.size() <= 200
          && data.customName is string && data.customName.size() <= 200
          && (data.get('address', null) == null
              || (data.address is string && data.address.size() <= 500))
          && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
          && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
          && data.status in ['WISHLIST', 'VISITED']
          && (data.get('visitedOn', null) == null || data.visitedOn is int)
          && (data.get('rating', null) == null
              || (data.rating is int && data.rating >= 1 && data.rating <= 5))
          // A place you want to visit has no visit date or rating.
          && (data.status == 'VISITED'
              || (data.get('visitedOn', null) == null && data.get('rating', null) == null))
          && data.notes is string && data.notes.size() <= 2000
          && data.marker is map
          && data.marker.keys().hasOnly(['type', 'iconKey', 'photoId', 'photoUrl'])
          // The marker photo's files are found from its id and the photo index. Places saved by
          // an older app version may still hold an empty photoUrl key; a link is never accepted.
          && data.marker.get('photoUrl', null) == null
          && data.members is list && data.members.size() <= 50
          && data.memberEmails is list && data.memberEmails.size() == data.members.size()
          && data.collaboratorEmails is list
          && data.collaboratorEmails.size() <= data.memberEmails.size()
          && (data.get('photoUploaders', null) == null || data.photoUploaders is map)
          && data.createdAt is int && data.updatedAt is int;
      }

      function changedOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      // Also governs queries: a list query must filter on ownerId == uid or
      // memberEmails array-contains the caller's email.
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid || myEmail() in resource.data.memberEmails);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        // The owner already has the place, so they can't also be one of its members.
        && !(myEmail() in request.resource.data.memberEmails)
        // The owner email shown to invitees must be the creator's own sign-in email.
        && (request.resource.data.get('ownerEmail', null) == null
            || request.resource.data.ownerEmail == myEmail())
        && isValidPlace(request.resource.data)
        // A new place's photos are all the owner's.
        && photoIndex(request.resource.data).values().hasOnly([request.auth.uid])
        && ownsCollection(request.resource.data.collectionId);

      allow update: if signedIn()
        && isValidPlace(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('ownerName', null) == resource.data.get('ownerName', null)
        && request.resource.data.get('ownerEmail', null) == resource.data.get('ownerEmail', null)
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          // Owner: anything; a different collection must also be theirs, and they can't be a member.
          // Photos only leave the index here (deleted, or with a removed member); adding the
          // owner's own photos is the photos branch below.
          (resource.data.ownerId == request.auth.uid
            && !(myEmail() in request.resource.data.memberEmails)
            && photoIndexOnlyShrinks()
            && (request.resource.data.collectionId == resource.data.collectionId
                || ownsCollection(request.resource.data.collectionId)))
          // Collaborator: the place's own details only.
          || (myEmail() in resource.data.collaboratorEmails
            && changedOnly(['actualName', 'customName', 'address', 'latitude', 'longitude',
                            'status', 'visitedOn', 'rating', 'notes', 'marker', 'updatedAt']))
          // Any member: leave, removing exactly themselves and their own photos.
          || (myEmail() in resource.data.memberEmails
            && changedOnly(['members', 'memberEmails', 'collaboratorEmails', 'photoUploaders',
                            'marker', 'updatedAt'])
            && removesExactlyMyPhotos()
            && keepsMarkerOrDropsRemovedPhoto()
            && request.resource.data.memberEmails == resource.data.memberEmails.removeAll([myEmail()])
            && request.resource.data.collaboratorEmails
                 == resource.data.collaboratorEmails.removeAll([myEmail()])
            && request.resource.data.members.size() == resource.data.members.size() - 1)
          // Anyone on the place: add their own photos to the index, or remove their own (with a
          // marker that showed one). The photo documents are written in the same transaction.
          || ((resource.data.ownerId == request.auth.uid || myEmail() in resource.data.memberEmails)
            && ((changedOnly(['photoUploaders', 'updatedAt']) && addsOnlyMyPhotos())
                || (changedOnly(['photoUploaders', 'marker', 'updatedAt'])
                    && removesOnlyMyPhotos()
                    && keepsMarkerOrDropsRemovedPhoto())))
        );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // places/{placeId}/photos/{photoId}: one document per photo, so a private photo can be
      // hidden from everyone but its uploader (rules can't hide part of a document). The file
      // itself is in Storage, under the uploader's own folder (see storage.rules).
      match /photos/{photoId} {

        function placePath() {
          return /databases/$(database)/documents/places/$(placeId);
        }

        function canSeePlace(place) {
          return place.ownerId == request.auth.uid || myEmail() in place.memberEmails;
        }

        // Field names mirror PhotoDocument. The photo's files are found from the place, the
        // uploader and the photo id (storage.rules checks who may download them), so nothing
        // about Storage is stored.
        function isValidPhoto(data) {
          return data.keys().hasOnly(['uploaderId', 'isPrivate', 'createdAt'])
            && data.isPrivate is bool
            && data.createdAt is int;
        }

        // Shared photos: everyone on the place. Private photos: only their uploader. A list
        // query must filter on isPrivate == false, or on uploaderId == the caller's uid.
        allow read: if signedIn()
          && canSeePlace(get(placePath()).data)
          && (resource.data.isPrivate == false || resource.data.uploaderId == request.auth.uid);

        // Anyone on the place can add their own photos, listed under their uid in the place's
        // photo index. That's how the owner finds every photo later.
        function canAddPhoto(place) {
          return canSeePlace(place) && photoIndex(place).get(photoId, null) == request.auth.uid;
        }

        // getAfter, so a new place and its photos can be written in one batch. Each photo costs
        // one document lookup and a batch may make at most 20, so the app writes photos 10 per
        // batch or transaction (PHOTOS_PER_WRITE in FirestorePlaceRepository).
        allow create: if signedIn()
          && request.resource.data.uploaderId == request.auth.uid
          && isValidPhoto(request.resource.data)
          && canAddPhoto(getAfter(placePath()).data);

        // The uploader decides who sees their photo: only isPrivate changes. The place's marker
        // photo stays shared, because markers are visible to everyone on the place.
        allow update: if signedIn()
          && resource.data.uploaderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPrivate'])
          && request.resource.data.isPrivate is bool
          && canSeePlace(get(placePath()).data)
          && !(request.resource.data.isPrivate == true
               && get(placePath()).data.marker.get('photoId', null) == photoId);

        // The uploader removes their own photo; the owner can remove any photo on their place.
        // Deleting one that's already gone is allowed, so an interrupted cleanup can be retried.
        allow delete: if signedIn()
          && (resource == null
              || resource.data.uploaderId == request.auth.uid
              || get(placePath()).data.ownerId == request.auth.uid);
      }
    }
  }
}
